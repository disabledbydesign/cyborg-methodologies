__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
*.DS_Store

# Timestamped backups — the git history is the backup
*.bak
*.bak.*
*.bak-*
*.orig
*.rej
*.installed-copy

# Personal context files (filled-in project instances)
contexts/

# Personal voice profiles.
# NOTE: `profiles/*` contains a slash, so git anchors it to the repo ROOT and it
# does NOT match voice-check/profiles/. That gap left june_bloch.json (240 KB of
# June's personal writing profile) untracked-but-unignored in a PUBLIC repo — one
# `git add -A` away from being published. The `**/` forms below close it.
**/profiles/*
!**/profiles/base.json

# Writing samples used for calibration
samples/

# Research session notes
sessions/

# Explicitly personal or private files
*.personal.*
*.private.*

# Dev handoff notes (contain personal paths)
HANDOFF.md

# Tool artifacts (MemPalace, graphify)
entities.json
mempalace.yaml
graphify-out/

# private raw session data (added 2026-06-25)
**/raw_transcripts/
**/*.jsonl

# Per-machine agent settings — local to one checkout, not method
.claude/
**/.claude/
.obsidian/
